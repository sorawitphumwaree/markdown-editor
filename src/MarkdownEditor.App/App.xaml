<Application x:Class="MarkdownEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#17181E"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F6F3FC"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D8CEF5"/>
    <SolidColorBrush x:Key="BrandCharcoalBrush" Color="#17181E"/>
    <SolidColorBrush x:Key="BrandVioletBrush" Color="#9B7CE5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6D4CC4"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#7357C8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EEE9FC"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#61616B"/>
    <Style TargetType="{x:Type Hyperlink}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Application.Resources>
</Application>
