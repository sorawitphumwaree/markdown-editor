<Window x:Class="MarkdownEditor.App.TranslationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Settings" Width="430" Height="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Word translation" FontSize="18" FontWeight="SemiBold"/>
    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Source language" VerticalAlignment="Center"/>
      <ComboBox x:Name="SourceLanguage" Grid.Column="1" SelectedValuePath="Tag">
        <ComboBoxItem Content="English" Tag="en"/>
        <ComboBoxItem Content="Thai" Tag="th"/>
      </ComboBox>
    </Grid>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Destination" VerticalAlignment="Center"/>
      <ComboBox x:Name="DestinationLanguage" Grid.Column="1" SelectedValuePath="Tag">
        <ComboBoxItem Content="English" Tag="en"/>
        <ComboBoxItem Content="Thai" Tag="th"/>
      </ComboBox>
    </Grid>
    <TextBlock Grid.Row="3" Margin="0,18,0,0" TextWrapping="Wrap"
               Foreground="#61616B"
               Text="English → Thai is supported in this release. Translating sends only the selected word to MyMemory and Dictionary API over the internet; no surrounding document content is sent."/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="82" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Width="82" IsDefault="True" Click="Save"/>
    </StackPanel>
  </Grid>
</Window>
